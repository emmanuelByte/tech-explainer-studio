{
  "name": "tech-explainer-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "vite --port 3000",
    "dev": "vite --port 3005",
    "build": "vite build",
    "lint": "eslint .",
    "render": "remotion render src/remotion/index.tsx EditorComposition",
    "remotion:compositions": "remotion compositions src/remotion/index.tsx",
    "hero:studio": "remotion studio src/remotion/hero/index.ts",
    "hero:render": "remotion render src/remotion/hero/index.ts CachingHero out/caching-hero.mp4 --color-space=bt709",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:watch": "vitest",
    "produce": "npm run -s lesson -- produce",
    "lesson": "esbuild tools/lesson/cli.ts --bundle --platform=node --format=esm --outfile=node_modules/.cache/lesson-cli.mjs --log-level=warning && node node_modules/.cache/lesson-cli.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@remotion/player": "4.0.463",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-virtual": "^3.14.11",
    "i18next": "^26.2.0",
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-i18next": "^17.0.8",
    "remotion": "4.0.463",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@remotion/cli": "4.0.463",
    "@types/node": "25.9.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.0.12",
    "vitest": "^4.1.0"
  }
}
